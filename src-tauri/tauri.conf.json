{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skylark",
  "version": "0.1.3",
  "identifier": "com.skylark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skylark",
        "create": false,
        "backgroundColor": "#0b1230",
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://osmtile.localhost https://api.librewxr.net https://*.librewxr.net; connect-src 'self' ipc: http://ipc.localhost https://api.librewxr.net https://*.librewxr.net; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjg0OEY2N0QzNEIzNTcKUldSWHN6Ujk5a2o0d2lkSm1CeDIyWmp2VWlhK3dEOVlHNDQ4VnpQT3BpOXBVajZKQS9SblUyOVkK",
      "endpoints": [
        "https://github.com/Ad1FPS/Skylark/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
